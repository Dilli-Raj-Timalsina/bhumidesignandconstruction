# Supabase project URL, safe for browser use
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key, safe for browser use with RLS enabled
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Required only for privileged administrative operations.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: canonical public URL, used for metadata, sitemap and robots output
NEXT_PUBLIC_SITE_URL=
