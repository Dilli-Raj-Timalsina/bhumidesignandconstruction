# Supabase project URL, safe for browser use
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (`sb_publishable_...`), safe for browser use with RLS enabled.
# This project retains the legacy-compatible variable name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key (`sb_secret_...`), server-only. This project retains the
# legacy-compatible variable name; never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# The one CMS administrator. These are server-only values; do not prefix them
# with NEXT_PUBLIC_ or commit the real values. ADMIN_EMAIL is the login ID and
# must be an email address because Supabase password authentication uses email.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# An independent, random 32+ character secret used only to HMAC login-rate
# limit keys. It must not be the same value as ADMIN_PASSWORD.
ADMIN_RATE_LIMIT_SECRET=

# Optional: canonical public URL, used for metadata, sitemap and robots output
NEXT_PUBLIC_SITE_URL=
